API_TOKEN=replace-with-at-least-32-random-characters
ROUTER_USERNAME=root
ROUTER_PASSWORD=replace-securely-on-server
ROUTER_URL=http://192.168.100.1
WRITES_ENABLED=false
VERIFIED_WRITES=false
# Comma-separated addresses for your server and administration devices.
PROTECTED_MACS=
PROTECTED_IPS=
POLL_SECONDS=60
OFFLINE_POLLS=2
RETENTION_DAYS=90
# Optional private HTTPS ntfy topic. Native app also provides delayed WorkManager notifications.
NTFY_URL=
NTFY_TOKEN=
# Optional existing AdGuard Home, reached only from the backend. Leave URL blank to disable.
# Example when hosted on this server: ADGUARD_URL=http://host.docker.internal:3000
ADGUARD_URL=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
ADGUARD_DNS_HOST=host.docker.internal
